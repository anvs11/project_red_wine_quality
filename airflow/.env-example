# === Airflow Basic Settings ===
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.0
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=..

# === First-time init ===
_AIRFLOW_DB_UPGRADE=true
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# === Dependencies for ML pipeline ===
# Устанавливаются при старте контейнера
_PIP_ADDITIONAL_REQUIREMENTS="joblib mlflow scikit-learn pandas numpy catboost matplotlib seaborn dvc[s3]"

# === Executor: LocalExecutor для локальной разработки ===
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# === MinIO / S3 credentials for DVC ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://s3.lab.karpov.courses
AWS_DEFAULT_REGION=us-east-1  # MinIO часто требует регион, даже фиктивный